{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zecpath.example/schemas/transcript.schema.json",
  "title": "Zecpath AI Screening Transcript",
  "description": "A structured voice-screening transcript. Timestamps are normalized to UTC. Confidence is optional if not supplied by the speech recognition component.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transcript_id",
    "session_id",
    "candidate_id",
    "job_id",
    "language",
    "created_at_utc",
    "turns"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "transcript_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "description": "BCP 47 language tag, e.g. en-IN."
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "turn_id",
          "sequence_no",
          "speaker_role",
          "question_id",
          "timestamp_utc",
          "raw_text",
          "normalized_text",
          "confidence",
          "source",
          "language"
        ],
        "properties": {
          "turn_id": {
            "type": "string",
            "minLength": 1
          },
          "sequence_no": {
            "type": "integer",
            "minimum": 1
          },
          "speaker_role": {
            "enum": [
              "interviewer",
              "candidate",
              "system"
            ]
          },
          "question_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "timestamp_utc": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "raw_text": {
            "type": "string",
            "minLength": 1
          },
          "normalized_text": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "source": {
            "enum": [
              "speech_to_text",
              "typed",
              "system_generated"
            ]
          },
          "language": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    }
  }
}
